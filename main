-- минимальный тест — одна строка
local w = "https://discord.com/api/webhooks/1555651221577269269/-CmLD2ScT3WzjxODdjWrYE4ip_BexnMuQBZ7JR4ZxYhTFOx-dLwaJRo8jdRmAvJo-r34"

local r = (syn and syn.request) or (http and http.request) or http_request or request
if not r then
    warn("NO HTTP FUNCTION IN EXECUTOR")
    return
end

local h = game:GetService("HttpService")
local p = h:JSONEncode({ content = "ping", username = "test" })

local ok, res = pcall(r, {
    Url = w, Method = "POST",
    Headers = { ["Content-Type"] = "application/json" },
    Body = p,
})

warn("ok: " .. tostring(ok))
warn("status: " .. tostring(res and res.StatusCode))
warn("body: " .. tostring(res and res.Body))
